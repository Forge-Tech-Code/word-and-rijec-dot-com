<?xml version="1.0" encoding="UTF-8"?>
<!-- Two pages now, one per language, each listing itself and its alternate.
     Google wants the hreflang set to be RECIPROCAL and to include the page
     itself, which is why both <url> blocks carry the same three <xhtml:link>
     entries; they mirror what src/components/Seo.jsx puts in each page's head.

     robots.txt points crawlers here. Bump both <lastmod> values whenever the
     page content changes. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>https://word-and-rijec.com/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="https://word-and-rijec.com/" />
    <xhtml:link rel="alternate" hreflang="hr" href="https://word-and-rijec.com/hr/" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://word-and-rijec.com/" />
    <lastmod>2026-10-08</lastmod>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://word-and-rijec.com/hr/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="https://word-and-rijec.com/" />
    <xhtml:link rel="alternate" hreflang="hr" href="https://word-and-rijec.com/hr/" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://word-and-rijec.com/" />
    <lastmod>2026-10-08</lastmod>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
